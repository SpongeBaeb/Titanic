# 필요한 환경 변수 목록 (참고용). 이 앱은 .env 파일을 자동으로 읽지 않습니다.
# 로컬: 서버를 띄우는 셸에서 설정 (PowerShell 예: $env:SUPABASE_URL = "https://xxxx.supabase.co")
# 배포: 호스팅 서비스의 환경 변수(Config Vars) 설정에 입력
#
# SUPABASE_URL / SUPABASE_KEY 가 없으면 SQLite(results.db)만 사용합니다.
# 배포 환경에서는 SQLite 가 재시작 때 사라질 수 있어 공유 링크가 깨질 수 있습니다.
SUPABASE_URL=
SUPABASE_KEY=

# development 로 설정하면 관리자 API 와 Flask debug 모드가 켜집니다. 운영에서는 비워 두세요.
FLASK_ENV=

# 장면 도달 통계(/api/admin/funnel?token=...)를 운영에서 볼 때 쓰는 값. 비워 두면 운영에서는 볼 수 없습니다.
ADMIN_TOKEN=
